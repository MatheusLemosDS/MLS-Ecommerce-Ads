  "storage": {
    "d1Json": {
      "scope": "PHYSICAL_ORG_STORE_NAMESPACE",
      "columns": [
        "payload",
        "payload_hash",
        "values_json",
        "settings_snapshot",
        "result",
        "summary",
        "items",
        "selection_json",
        "declarations_json",
        "response_json",
        "details_json",
        "model_ids_json",
        "lines_json"
      ],
      "rule": "Preserve stored JSON bytes, snapshots, hashes, revisions and idempotency keys; namespace the owning SQL object, never rewrite payload values."
    },
    "browserPersistent": [
      {
        "api": "indexedDB",
        "name": "brazacommerce-dtf-artworks-v1",
        "store": "artworks",
        "keyPath": "art_key",
        "source": "web/cloudflare/src/dtf-view.mjs",
        "rule": "Use a user/org/store database name for commercial principals; legacy library stays with the legacy principal only."
      }
    ],
    "sharedVisualPreference": {
      "api": "localStorage",
      "name": "braza-theme",
      "source": "web/cloudflare/src/theme.mjs",
      "data": "NON_DOMAIN_VISUAL_PREFERENCE"
    },
    "serverCaches": {
      "key": "DATABASE_WRAPPER_IDENTITY",
      "rule": "Reuse one scoped wrapper per underlying binding and trusted org/store namespace; never reuse an unscoped ready/cache identity between tenants.",
      "sources": [
        "web/cloudflare/src/admin.mjs",
        "web/cloudflare/src/production-weekly-close.mjs",
        "web/cloudflare/src/weekly-operating-store.mjs",
        "web/finance/src/external-cash-store.mjs"
      ]
    },
    "browserTransient": [
      "web/cloudflare/src/admin-client.mjs",
      "web/cloudflare/src/business-month-client.mjs",
      "web/cloudflare/src/business-reconciliation-view.mjs",
      "web/cloudflare/src/escrow-releases-view.mjs",
      "web/cloudflare/src/mls-product-workbench-view.mjs",
      "web/cloudflare/src/cost-rules-view.mjs",
      "web/cloudflare/src/saved-catalog-view.mjs",
      "web/cloudflare/src/physical-returns-view.mjs",
      "web/cloudflare/src/returns-case-cards-view.mjs",
      "web/cloudflare/src/incurred-production-view.mjs",
      "web/cloudflare/src/production-coverage-view.mjs",
      "web/cloudflare/src/production-weekly-view.mjs",
      "web/cloudflare/src/return-manufacturing-links-view.mjs",
      "web/cloudflare/src/dtf-view.mjs",
      "web/cloudflare/src/bank-reconciliation-view.mjs",
      "web/cloudflare/src/mls-listing-factory-view.mjs",
      "web/cloudflare/src/mls-ai-sales-view.mjs"
    ],
    "scopeChangeRule": "Abort pending requests; close IndexedDB handles; revoke Blob URLs; clear all in-memory snapshots, charts, month/record caches, drafts and attachment proofs before mounting the next principal. A full document navigation satisfies teardown only if persistent storage is scoped.",
    "legacyProviderIdentity": {
